---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SoftwareStack from '../components/SoftwareStack.astro';
import TrafficDemo from '../components/TrafficDemo.astro';
import { site } from '../data/site';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <div class="wrap hero-text">
    <h1>{site.tagline}</h1>
    <p>We are the Industrial Mathematics Group at RPTU Kaiserslautern-Landau. We develop models, numerical methods and open-source software for problems from science and industry.</p>
  </div>

  <TrafficDemo />

  <div class="wrap">
    <section class="section">
      <h2>Research</h2>
      <div>
        <div class="research-list">
          {research.map((entry) => (
            <div>
              <h3><a href={`/research/#${entry.id}`}>{entry.data.title}</a></h3>
              <p>{entry.data.summary}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Software</h2>
      <div>
        <SoftwareStack />
        <p style="margin-top:1.25rem"><a href="/software/">All software, including code for our papers</a></p>
      </div>
    </section>

    <section class="section">
      <h2>Open science</h2>
      <div class="prose">
        <p>Our code is open source, and releases are archived with DOIs in our <a href={site.zenodo}>Zenodo community</a>.</p>
        <p>AI tools are welcome in our work, as long as their use is declared. Every change to the main branch of our repositories states how it was written and how it was reviewed, on three scales. A change marked G2, H2, A1 was generated by AI, read line by line by a person, and checked by an independent AI session.</p>
        <p><a href={site.aiPolicy}>Read the AI policy</a></p>
      </div>
    </section>
  </div>
</Layout>
