---
import katex from 'katex';
import { url } from '../data/site';

const equation = katex.renderToString(
  String.raw`\partial_t f_i^c + v_i\,\partial_x f_i^c = J_i^c(f, \partial_x f) + \tfrac{1}{\epsilon}\big(f_i^{e,c} - f_i^c\big)`,
  { throwOnError: true },
);
---

<section class="traffic" data-traffic aria-label="Interactive traffic simulation">
  <canvas
    hidden
    role="img"
    aria-label="The densities of two classes of vehicles on a ring road, with dots for the vehicles. At medium density, small disturbances grow into stop-and-go waves."
  ></canvas>
  <div class="wrap traffic-panel">
    <p>
      This demo runs a kinetic model for two classes of vehicles with different top speeds. Vehicles brake when the traffic ahead gets denser, and return to the preferred speed of their class within a time ε: <Fragment set:html={equation} />. At medium density, small disturbances grow into stop-and-go waves. Click the road to make drivers brake. <a href={url('/news/traffic-demo/')}>How this works</a>
    </p>
    <div class="controls" data-controls hidden>
      <label>
        Density
        <input type="range" min="0" max="5" step="1" value="3" data-density />
        <output data-density-output>50 %</output>
      </label>
      <button type="button" data-brake>Make drivers brake</button>
      <button type="button" data-play>Pause</button>
    </div>
  </div>
</section>
<script is:inline type="module" src={url('/js/traffic.js')}></script>
